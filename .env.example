# ═══════════════════════════════════════
# Ellen Bot — Environment Variables
# ═══════════════════════════════════════
# Copy to .env and fill in your values:
#   cp .env.example .env

# Telegram
TELEGRAM_BOT_TOKEN=           # From @BotFather on Telegram
OWNER_TELEGRAM_ID=            # Your Telegram numeric user ID

# AI Models
GLM_API_KEY=                  # ZhipuAI GLM-4-Flash API key
ANTHROPIC_API_KEY=            # Anthropic API key (fallback model)

# Google APIs
GOOGLE_CLIENT_ID=             # Google OAuth client ID
GOOGLE_CLIENT_SECRET=         # Google OAuth client secret

# Instagram (via Composio)
INSTAGRAM_ACCESS_TOKEN=       # Instagram Graph API token
COMPOSIO_API_KEY=             # Composio platform API key

# Image Generation
IMAGE_GEN_API_KEY=            # Image generation service API key

# Deployment
RAILWAY_TOKEN=                # Railway deploy token (optional)
